@using System.Diagnostics
@using NAPLPS
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<h3>NAPLPS in the browser</h3>

<p>
    <label>
        speed:
        <select @bind="baud">
            @foreach (var rate in NaplpsBaud.Rates)
            {
                <option value="@rate">@NaplpsBaud.Describe(rate)@(rate == NaplpsBaud.Default ? " — live" : "")</option>
            }
        </select>
    </label>
    <button @onclick="Restart">restart</button>
    <InputFile OnChange="LoadLocalFile" />
</p>

<p><b>@status</b></p>

<canvas @ref="canvas" style="max-width:100%;border:1px solid #333;image-rendering:pixelated"></canvas>

@code {
    // The session is driven here exactly the way a native client drives naplps_ctx_*:
    // append a chunk, exec to the newest complete command, copy the framebuffer into a
    // reused caller-owned buffer, blit. Costs scale with the chunk, never the session.
    private const int RenderWidth = 1024;
    private const int RenderHeight = 768;

    private ElementReference canvas;
    private NaplpsStreamSession? session;
    private byte[] streamBytes = [];
    private readonly byte[] rgba = new byte[RenderWidth * RenderHeight * 4];
    private CancellationTokenSource? playback;

    private string status = "loading...";
    private int baud = NaplpsBaud.Default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            streamBytes = await Http.GetByteArrayAsync("sample/bb8.nap");
            await Play();
        }
    }

    private async Task LoadLocalFile(InputFileChangeEventArgs e)
    {
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024).CopyToAsync(ms);
        streamBytes = ms.ToArray();
        await Play();
    }

    private Task Restart() => Play();

    private async Task Play()
    {
        playback?.Cancel();
        playback = new CancellationTokenSource();
        var token = playback.Token;

        session?.Dispose();
        var live = new NaplpsStreamSession(RenderWidth, RenderHeight, prodigy: false);
        session = live;

        // One tick per frame-ish interval, chunk sized to what the wire delivers in it.
        // Fastest still slices with a real delay: Blazor wasm shares the UI thread, and an
        // unyielding decode-and-paint of a whole file locks the browser.
        const int tickMs = 50;
        var chunk = baud > 0
            ? Math.Max(1, (int)(baud / NaplpsBaud.BitsPerByte * tickMs / 1000.0))
            : 16 * 1024;

        var sw = Stopwatch.StartNew();
        var offset = 0;

        try
        {
            while (offset < streamBytes.Length)
            {
                token.ThrowIfCancellationRequested();

                var len = Math.Min(chunk, streamBytes.Length - offset);
                live.Append(streamBytes[offset..(offset + len)]);
                offset += len;

                await PaintLatest(live);
                status = $"streaming - {offset}/{streamBytes.Length} bytes, {live.CommandCount} commands";
                StateHasChanged();

                await Task.Delay(baud > 0 ? tickMs : 1, token);
            }

            // Only the driver knows the stream ended: release a command whose operand
            // list ran to the last byte.
            live.Flush();
            await PaintLatest(live);

            status = $"done - {streamBytes.Length} bytes, {live.CommandCount} commands in {sw.ElapsedMilliseconds}ms";
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            // A cancelled run may observe its session disposed under it; only a live run's
            // failure is news.
            if (!token.IsCancellationRequested)
            {
                status = "FAILED: " + ex.GetType().Name + ": " + ex.Message;
                StateHasChanged();
            }
        }
    }

    private async Task PaintLatest(NaplpsStreamSession live)
    {
        live.ExecTo(Math.Max(0, live.CommandCount - 1));
        live.CopyFramebufferTo(rgba);
        await JS.InvokeVoidAsync("naplpsBlit", canvas, RenderWidth, RenderHeight, rgba);
    }

    public void Dispose()
    {
        playback?.Cancel();
        session?.Dispose();
    }
}
