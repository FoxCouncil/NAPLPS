<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- net10.0 is the desktop app (telidraw.exe / telidraw.app). net10.0-browser builds the
		     same code as a library for the Telidraw.Browser WASM head; a mobile head would add
		     its TFM the same way. Desktop-only bits are conditioned on the base TFM below. -->
		<TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
		<OutputType>WinExe</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net10.0-browser'">Library</OutputType>
		<AssemblyName>Telidraw</AssemblyName>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport Condition="'$(TargetFramework)' == 'net10.0'">true</BuiltInComInteropSupport>
		<ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0'">app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
		<!-- AvaloniaEdit needs the XSHD via Assembly.GetManifestResourceStream, so it must
		     also be an EmbeddedResource (Avalonia assets can't be reached that way). -->
		<EmbeddedResource Include="Assets\TelidrawHighlighting.xshd"/>
	</ItemGroup>

	<ItemGroup>
	  <AvaloniaXaml Remove="Models\**" />
	  <Compile Remove="Models\**" />
	  <EmbeddedResource Remove="Models\**" />
	  <None Remove="Models\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.1" />
		<PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
		<PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.1" Condition="'$(TargetFramework)' == 'net10.0'" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
		<!-- Avalonia.Diagnostics: no 12.x released yet; re-enable once it ships. -->
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
		<PackageReference Include="bodong.Avalonia.PropertyGrid" Version="12.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- 12.0.0 is the Avalonia-12-compatible line; the 3.x line references Avalonia 11
		     types (SystemDecorations) that no longer exist and dies on type load. -->
		<PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
		<PackageReference Include="ScottPlot" Version="5.1.59" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
		<PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
		<PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NAPLPS\NAPLPS.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\AddCommandWindow.axaml.cs">
	    <DependentUpon>AddCommandWindow.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>
</Project>
