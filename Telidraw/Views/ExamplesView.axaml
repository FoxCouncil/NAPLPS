<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Telidraw.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="480"
		x:Class="Telidraw.Views.ExamplesView"
		x:DataType="vm:ExamplesViewModel">
	<DockPanel Margin="12">
		<TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontSize="11" Opacity="0.8" Margin="0,0,0,8" TextWrapping="Wrap"/>

		<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
			<Button Content="Open" Command="{Binding OpenCommand}" Width="90" HorizontalContentAlignment="Center" IsDefault="True"/>
			<Button Content="Cancel" Command="{Binding CancelCommand}" Width="90" HorizontalContentAlignment="Center" IsCancel="True"/>
		</StackPanel>

		<ListBox ItemsSource="{Binding Examples}" SelectedItem="{Binding SelectedExample}" DoubleTapped="OnListDoubleTapped"/>
	</DockPanel>
</UserControl>
