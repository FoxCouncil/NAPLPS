<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:Telidraw.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="clr-namespace:Telidraw.Views"
		mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
		x:Class="Telidraw.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/naplps.ico"
		Title="{Binding TitleBarDisplay}">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<!-- The entire editor lives in MainView so the identical UI runs under a single-view
	     lifetime (browser, mobile). This window is only the desktop chrome around it. -->
	<views:MainView/>
</Window>
